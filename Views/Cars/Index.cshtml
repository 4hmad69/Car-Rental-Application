@model System.Collections.Generic.List<Car_Rental_Application.Models.Car>

@{
    ViewData["Title"] = "Available Cars";
}

<div class="mb-4">
    <h1>Available Cars</h1>
    <p class="text-muted">
        Choose your preferred car and book it below.
    </p>
</div>

@if (Model.Count > 0)
{
    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-3">
        @foreach (var car in Model)
        {
            <div class="col">
                <div class="card h-100 shadow-sm">
                    <div class="card-body p-4">
                        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
                            <h2 class="h5 mb-0">@car.Name</h2>

                            <span class="badge bg-success">
                                Available
                            </span>
                        </div>

                        <p class="text-muted mb-1">Daily rental price</p>

                        <p class="fs-4 fw-bold mb-0">
                            PKR @car.PricePerDay.ToString("N0")
                        </p>
                    </div>

                    <div class="card-footer bg-transparent border-0 p-4 pt-0">
                        <form method="post"
                              asp-controller="Cars"
                              asp-action="Book">
                            <input name="id"
                                   value="@car.Id"
                                   type="hidden" />

                            <button class="btn btn-primary w-100"
                                    type="submit">
                                Book Car
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        }
    </div>
}
else
{
    <div role="alert" class="alert alert-info">
        All cars are currently booked. Please check again later.
    </div>
}