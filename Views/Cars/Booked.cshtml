@model System.Collections.Generic.List<Car_Rental_Application.Models.Car>
@{
    ViewData["Title"] = "Booked Cars";
}

<div class="d-flex align-items-center justify-content-between flex-wrap gap-3 mb-4">
    <div>
        <h1 class="mb-1">Booked Cars</h1>
        <p class="text-muted mb-0">
            Cars that have already been reserved.
        </p>
    </div>

    <a class="btn btn-outline-primary"
       asp-controller="Cars"
       asp-action="Index">
        Back to Cars
    </a>
</div>

@if (Model.Count > 0)
{
    <div class="table-responsive">
        <table class="table table-hover table-striped align-middle">
            <thead class="table-dark">
                <tr>
                    <th scope="col">ID</th>
                    <th scope="col">Car Name</th>
                    <th scope="col" class="text-end">Price Per Day</th>
                    <th scope="col" class="text-center">Status</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var car in Model)
                {
                    <tr>
                        <td>@car.Id</td>
                        <td class="fw-bold">@car.Name</td>
                        <td class="text-end">
                            PKR @car.PricePerDay.ToString("N0")
                        </td>
                        <td class="text-center">
                            <span class="badge bg-warning text-dark">
                                Booked
                            </span>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
else
{
    <div role="alert" class="alert alert-info">
        Your booked cars will appear here once you reserve a car.
    </div>
}